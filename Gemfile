source "https://rubygems.org"

# Matches the exact versions GitHub Pages runs, so what you see locally
# is what ships. https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

# Ruby 3.x no longer bundles these, and Jekyll wants them.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
